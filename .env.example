# ============================================================================
# BioQL Ecosystem - Environment Variables Configuration
# ============================================================================
# This file contains all environment variables used by the BioQL system.
# Copy this file to .env and fill in the actual values for your environment.
# IMPORTANT: Never commit the actual .env file to version control.
# ============================================================================


# ============================================================================
# API Keys & Tokens
# ============================================================================

# BioQL API Key
# Purpose: Main API key for authenticating requests to BioQL services
# Generate: Available from the BioQL Dashboard at https://dashboard.bioql.io
# Format: String (alphanumeric, typically 32+ characters)
BIOQL_API_KEY=your_bioql_api_key_here

# IBM Quantum Token
# Purpose: Authentication token for accessing IBM Quantum services and simulators
# Generate: Available from IBM Quantum Experience at https://quantum.ibm.com
# Required: For quantum circuit simulation and execution on IBM backends
# Format: String (JWT token)
IBM_QUANTUM_TOKEN=your_ibm_quantum_token_here

# IonQ API Key
# Purpose: Authentication key for accessing IonQ trapped-ion quantum computers
# Generate: Available from IonQ Dashboard at https://dashboard.ionq.co
# Required: For executing quantum programs on IonQ hardware
# Format: String (alphanumeric)
IONQ_API_KEY=your_ionq_api_key_here

# OpenAI API Key
# Purpose: API key for Natural Language Processing (NLP) features
# Used for: Query interpretation, result summarization, and context understanding
# Generate: Available from OpenAI Dashboard at https://platform.openai.com/api-keys
# Format: String (starts with 'sk-' followed by alphanumeric characters)
OPENAI_API_KEY=sk_your_openai_api_key_here


# ============================================================================
# Database Configuration
# ============================================================================

# PostgreSQL Database URL
# Purpose: Connection string for the primary relational database
# Format: postgresql://username:password@host:port/database_name
# Example: postgresql://bioql_user:secure_password@localhost:5432/bioql_db
# Used for: Storing user data, quantum circuits, results, and system metadata
# Security: Use strong passwords and consider using environment-specific credentials
DATABASE_URL=postgresql://bioql_user:password@localhost:5432/bioql_db

# Redis URL
# Purpose: Connection string for the Redis cache and message broker
# Format: redis://username:password@host:port/database_number
# Example: redis://:password@localhost:6379/0
# Used for: Session management, caching, rate limiting, and job queues
# Security: Use authentication if Redis is exposed to the network
REDIS_URL=redis://localhost:6379/0


# ============================================================================
# Payment & Billing Configuration
# ============================================================================

# Stripe API Key (Secret)
# Purpose: Secret key for Stripe payment processing and billing operations
# Security: SENSITIVE - Never expose in client-side code or public repositories
# Generate: Available from Stripe Dashboard at https://dashboard.stripe.com/apikeys
# Used for: Processing payments, creating subscriptions, and managing billing
# Format: String (starts with 'sk_' followed by alphanumeric characters)
STRIPE_API_KEY=sk_test_your_stripe_secret_key_here

# Stripe Publishable Key
# Purpose: Public key for Stripe client-side integrations
# Security: Safe to expose in client-side code; used for card elements and payment forms
# Generate: Available from Stripe Dashboard at https://dashboard.stripe.com/apikeys
# Used for: Building payment forms and initializing Stripe.js
# Format: String (starts with 'pk_' followed by alphanumeric characters)
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# Stripe Webhook Secret
# Purpose: Secret key for verifying and validating Stripe webhook requests
# Security: SENSITIVE - Used to ensure webhooks come from Stripe
# Generate: Available from Stripe Dashboard Webhook Endpoints section
# Used for: Confirming payment events, subscription updates, and invoice notifications
# Format: String (starts with 'whsec_' followed by alphanumeric characters)
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here


# ============================================================================
# Server Configuration
# ============================================================================

# Flask Environment
# Purpose: Specifies the Flask application environment mode
# Values: 'development', 'production', or 'testing'
# Development: Enables debug mode, auto-reload, and detailed error messages
# Production: Disables debug mode, optimizes performance, and suppresses stack traces
# Testing: Configures app for running tests
FLASK_ENV=development

# Flask Secret Key
# Purpose: Secret key for session management and CSRF protection
# Security: SENSITIVE - Must be a strong, random value in production
# Generation: Can be generated with: python -c "import secrets; print(secrets.token_hex(32))"
# Length: Recommended minimum 32 characters
# Used for: Signing session cookies and CSRF tokens
FLASK_SECRET_KEY=your_super_secret_flask_key_change_in_production

# API Base URL
# Purpose: Base URL for the BioQL API service
# Development: http://localhost:5000
# Production: https://api.yourdomain.com
# Used for: Constructing API endpoints, CORS configuration, and API documentation
API_BASE_URL=http://localhost:5000

# Frontend URL
# Purpose: URL where the BioQL web interface is hosted
# Development: http://localhost:3000 (for React/Vue development server)
# Production: https://yourdomain.com
# Used for: CORS configuration, redirect URIs, and OAuth callbacks
FRONTEND_URL=http://localhost:3000


# ============================================================================
# AWS & Cloud Services Configuration
# ============================================================================

# AWS Access Key ID
# Purpose: Public identifier for AWS API authentication
# Security: SENSITIVE - Credentials should be rotated regularly
# Generate: Available from AWS IAM Console
# Used for: AWS SDK authentication, S3 operations, Lambda invocation, etc.
# Format: String (typically 20 characters, alphanumeric)
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here

# AWS Secret Access Key
# Purpose: Private key for AWS API authentication
# Security: CRITICAL - Never expose in public repositories or logs
# Generate: Available from AWS IAM Console (only shown once during creation)
# Used for: AWS SDK authentication and request signing
# Format: String (typically 40 characters, alphanumeric including +/)
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here

# Modal Token ID
# Purpose: User ID for Modal Labs authentication
# Generate: Available from Modal Dashboard at https://modal.com/account
# Used for: Deploying serverless functions and accessing Modal compute resources
# Format: String (alphanumeric)
MODAL_TOKEN_ID=your_modal_token_id_here

# Modal Token Secret
# Purpose: Secret key for Modal Labs API authentication
# Security: SENSITIVE - Used to sign requests to Modal API
# Generate: Available from Modal Dashboard at https://modal.com/account
# Used for: Authenticating requests to Modal serverless platform
# Format: String (alphanumeric, typically 32+ characters)
MODAL_TOKEN_SECRET=your_modal_token_secret_here


# ============================================================================
# Monitoring & Error Tracking
# ============================================================================

# Sentry DSN (Data Source Name)
# Purpose: Endpoint for error tracking and performance monitoring
# Generate: Available from Sentry Project Settings at https://sentry.io
# Format: https://<key>@<client>.ingest.sentry.io/<project_id>
# Used for: Capturing exceptions, performance metrics, and user feedback
# Optional: Leave empty to disable Sentry integration
SENTRY_DSN=https://your_sentry_key@client.ingest.sentry.io/your_project_id

# Log Level
# Purpose: Minimum log level for application logging
# Values: 'DEBUG', 'INFO', 'WARNING', 'ERROR', 'CRITICAL'
# DEBUG: Most verbose, includes all debug information
# INFO: General informational messages
# WARNING: Warning messages and above
# ERROR: Error messages and above (recommended for production)
# CRITICAL: Only critical failures
# Development: Use DEBUG for detailed troubleshooting
# Production: Use WARNING or ERROR for performance and security
LOG_LEVEL=INFO


# ============================================================================
# Additional Configuration Notes
# ============================================================================
#
# 1. Database Credentials:
#    - Use strong, unique passwords for production databases
#    - Consider using AWS Secrets Manager or similar for credential rotation
#    - Test database connectivity before deploying
#
# 2. API Keys Security:
#    - Rotate API keys periodically (quarterly recommended)
#    - Use separate keys for development, staging, and production
#    - Monitor API key usage for suspicious activity
#    - Never hardcode credentials in source code
#
# 3. Environment-Specific Settings:
#    - Create separate .env files for dev, staging, and production
#    - Use secure secret management systems (AWS Secrets Manager, HashiCorp Vault)
#    - Document any environment-specific overrides
#
# 4. Local Development:
#    - Copy this file to .env in your project root
#    - Fill in test/development API keys
#    - Ensure DATABASE_URL points to your local PostgreSQL instance
#    - Verify REDIS_URL is accessible from your development machine
#
# 5. Production Deployment:
#    - Never commit actual .env file to version control
#    - Use production-grade secret management systems
#    - Enable encryption for database connections
#    - Use HTTPS for all API endpoints
#    - Implement API rate limiting and authentication
#    - Set LOG_LEVEL to WARNING or ERROR
#    - Use distinct API keys for each service
#    - Enable monitoring with Sentry or equivalent
#
# 6. Testing:
#    - Create a separate .env.test file with test credentials
#    - Use mock/sandbox API keys when available
#    - Point to test database instances
#
# ============================================================================
