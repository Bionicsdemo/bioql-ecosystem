    "description": "BioQL similarity search snippet"
  },
  "BioQL Off-Target Screening": {
    "prefix": "bioql-offtarget",
    "body": [
      "from bioql import BioQLAgent",
      "",
      "# Initialize BioQL Agent",
      "agent = BioQLAgent(api_key='${1:your_api_key}')",
      "",
      "# Screen for off-targets",
      "molecule = '${2:aspirin}'",
      "results = agent.screen_offtargets(",
      "    molecule=molecule,",
      "    panel='${3|complete,safety,kinase,gpcr,custom|}',",
      "    threshold=1e-6  # Binding affinity threshold",
      ")",
      "",
      "# Display results",
      "print(f'Off-Target Screening for {molecule}:')",
      "for target, affinity in results.items():",
      "    if affinity < 1e-6:",
      "        print(f'{target}: {affinity:.2e} M (Potential off-target!)')$0"
    ],
    "description": "BioQL off-target screening snippet"
  },
