  "BioQL Bio-HNET Docking": {
    "prefix": "bioql-hnet-docking",
    "body": [
      "from bioql import BioQLAgent",
      "from bioql.bio_hnet import BioHNET",
      "",
      "# Initialize BioQL Agent",
      "agent = BioQLAgent(api_key='${1:your_api_key}')",
      "",
      "# Design Bio-HNET for molecular docking",
      "ligand = '${2:aspirin}'",
      "receptor = '${3:COX-2}'",
      "",
      "hnet = BioHNET(",
      "    task='docking',",
      "    ligand=ligand,",
      "    receptor=receptor",
      ")",
      "",
      "# Run Bio-HNET docking",
      "result = hnet.dock()",
      "",
      "# Display results",
      "print(f'Bio-HNET Docking: {ligand} to {receptor}')",
      "print(f'Binding Affinity: {result.affinity} kcal/mol')$0"
    ],
    "description": "BioQL Bio-HNET molecular docking snippet"
  },
