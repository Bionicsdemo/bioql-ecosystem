{
  "BioQL ADME Prediction": {
    "prefix": "bioql-adme",
    "body": [
      "from bioql import BioQLAgent",
      "",
      "# Initialize BioQL Agent",
      "agent = BioQLAgent(api_key='${1:your_api_key}')",
      "",
      "# Predict ADME properties",
      "molecule = '${2:aspirin}'",
      "result = agent.predict_adme(",
      "    molecule=molecule,",
      "    properties=['absorption', 'distribution', 'metabolism', 'excretion']",
      ")",
      "",
      "# Display results",
      "print(f'ADME Predictions for {molecule}:')",
      "print(result)$0"
    ],
    "description": "BioQL ADME/Tox prediction snippet"
  },
  "BioQL Toxicity Prediction": {
