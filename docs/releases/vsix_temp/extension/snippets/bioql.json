  "BioQL Bioisosteric Replacement": {
    "prefix": "bioql-bioisostere",
    "body": [
      "from bioql import BioQLAgent",
      "",
      "# Initialize BioQL Agent",
      "agent = BioQLAgent(api_key='${1:your_api_key}')",
      "",
      "# Suggest bioisosteric replacements",
      "molecule = '${2:aspirin}'",
      "replacements = agent.suggest_bioisosteres(",
      "    molecule=molecule,",
      "    replacement_type='${3|all,classical,nonclassical,scaffold|}',",
      "    max_replacements=12",
      ")",
      "",
      "# Display results",
      "print(f'Bioisosteric Replacements for {molecule}:')",
      "for idx, replacement in enumerate(replacements, 1):",
      "    print(f'{idx}. {replacement.smiles} (Score: {replacement.score})')$0"
    ],
    "description": "BioQL bioisosteric replacement snippet"
  },
  "BioQL Similarity Search": {
    "prefix": "bioql-similarity",
    "body": [
      "from bioql import BioQLAgent",
      "",
      "# Initialize BioQL Agent",
      "agent = BioQLAgent(api_key='${1:your_api_key}')",
      "",
      "# Search for similar compounds",
      "molecule = '${2:aspirin}'",
      "results = agent.search_similar(",
      "    molecule=molecule,",
