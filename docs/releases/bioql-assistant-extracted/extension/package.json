		"configuration": {
			"title": "BioQL Assistant",
			"properties": {
				"bioql.mode": {
					"type": "string",
					"enum": [
						"template",
						"modal",
						"local",
						"ollama"
					],
					"default": "modal",
					"description": "Inference mode: modal (cloud GPU with fine-tuned DeepSeek-Coder), template (instant, no setup), local (needs 16GB RAM), ollama (local optimized)"
				},
				"bioql.enableChat": {
					"type": "boolean",
					"default": true,
					"description": "Enable BioQL chat interface in VS Code"
				},
				"bioql.modalUrl": {
					"type": "string",
					"default": "https://spectrix--bioql-agent-create-fastapi-app.modal.run",
					"description": "Modal API URL (for modal mode) - Unified endpoint with DeepSeek fine-tuned model + billing"
				},
				"bioql.apiKey": {
					"type": "string",
					"default": "",
					"description": "BioQL API key for inference and quantum computer access"
				},
				"bioql.defaultBackend": {
					"type": "string",
					"enum": [
						"simulator",
						"ibm",
						"ionq",
						"aws",
						"aws_braket"
					],
					"default": "simulator",
					"description": "Default quantum backend (simulator, IBM Quantum, IonQ, AWS Braket)"
				},
				"bioql.enableQEC": {
					"type": "boolean",
					"default": false,
					"description": "Enable Quantum Error Correction (QEC) by default"
				},
				"bioql.qecType": {
					"type": "string",
					"enum": [
						"surface_code",
						"steane",
						"shor"
					],
					"default": "surface_code",
					"description": "Default QEC code type (Surface Code, Steane, or Shor)"
				},
				"bioql.defaultShots": {
					"type": "number",
					"default": 1000,
					"description": "Default number of measurement shots"
				},
				"bioql.enableVisualizations": {
					"type": "boolean",
					"default": true,
					"description": "Enable automatic Qualtran visualizations in generated code"
				},
				"bioql.quillowEnabled": {
					"type": "boolean",
					"default": true,
					"description": "Enable Quillow quantum error correction features"
				},
				"bioql.quillowDefaultDistance": {
					"type": "number",
					"default": 5,
					"enum": [3, 5, 7, 9],
					"description": "Default QEC code distance (higher = more protection)"
				},
				"bioql.quillowDefaultDecoder": {
					"type": "string",
					"default": "pymatching",
					"enum": ["pymatching", "unionfind", "gpu"],
					"description": "Default syndrome decoder algorithm"
				},
				"bioql.quillowAutoProtect": {
					"type": "boolean",
					"default": false,
					"description": "Automatically add QEC protection to quantum circuits"
				},
				"bioql.quillowMinCircuitDepth": {
					"type": "number",
					"default": 50,
					"description": "Minimum circuit depth to trigger auto-protection"
				}
			}
		}
